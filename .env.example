# ==============================================================================
# AETHER CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE & CACHING (Required)
# ------------------------------------------------------------------------------
# Default local Docker compose Postgres and Redis credentials:
DATABASE_URL="postgresql://user:password@localhost:5432/aether?schema=public"
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# 2. CASPIAN COMMUNICATION GATEWAY (Required for Discord / Telegram)
# ------------------------------------------------------------------------------
# Get your API key from Caspian Dashboard: https://trycaspianai.com
CASPIAN_API_KEY="comm_sandbox_your_api_key_here"
CASPIAN_BASE_URL="https://api.trycaspianai.com"

# ------------------------------------------------------------------------------
# 3. TELEGRAM BOT (Required for Telegram Ingress)
# ------------------------------------------------------------------------------
# Create a bot via @BotFather on Telegram (https://t.me/BotFather) and paste token:
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_from_botfather"

# ------------------------------------------------------------------------------
# 4. AI & SEARCH ENGINES (Required for Evidence Verification & LLM Scoring)
# ------------------------------------------------------------------------------
# Tavily AI Search API Key for autonomous multi-source web evidence: https://tavily.com
TAVILY_API_KEY="tvly-your_tavily_key"

# LLM Provider Key (Featherless, Groq, or OpenAI-compatible endpoint)
FEATHERLESS_API_KEY="your_llm_api_key"

# ------------------------------------------------------------------------------
# 5. GITHUB APP INTEGRATION (Optional - Only needed for GitHub Issue/PR Tracking)
# ------------------------------------------------------------------------------
# If you want Aether to track your own GitHub repositories, create a free GitHub App
# under: GitHub -> Settings -> Developer Settings -> GitHub Apps -> New GitHub App
# Set Webhook URL to: https://<your-domain>/api/github/webhook
# Generate a Private Key and paste the values below.
#
# (Note: Leave blank or omit if only using Web Search, 1v1 Bets, and Prediction Markets)
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
...your_github_private_key_here...
-----END RSA PRIVATE KEY-----"
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_APP_SLUG="aether-agent"
GITHUB_WEBHOOK_SECRET="your_custom_webhook_secret"
