generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// ENUMS
// ----------------------------------------------------------------------------

enum TriggerType {
  MANUAL
  WEBHOOK
  CRON
}

enum WorkflowStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELED
}

enum StepStatus {
  PENDING
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  RETRYING
}

enum EventType {
  WORKFLOW_CREATED
  WORKFLOW_STARTED
  WORKFLOW_COMPLETED
  WORKFLOW_FAILED
  STEP_QUEUED
  STEP_STARTED
  STEP_COMPLETED
  STEP_FAILED
  STEP_RETRY_SCHEDULED
  STEP_CANCELLED
  WORKER_REGISTERED
  WORKER_DISCONNECTED
}

// ----------------------------------------------------------------------------
// MODELS
// ----------------------------------------------------------------------------

/// Represents a human or system actor interacting with FlowPilot.
model User {
  id         String   @id @default(uuid())
  email      String   @unique
  apiKeyHash String?  @unique @map("api_key_hash")
  createdAt  DateTime @default(now()) @map("created_at")

  workflows Workflow[]

  @@map("users")
}

/// Represents the static blueprint generated by the Planner or defined manually.
model Workflow {
  id          String      @id @default(uuid())
  userId      String      @map("user_id")
  name        String
  description String?
  triggerType TriggerType @map("trigger_type")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  stepDefinitions    StepDefinition[]
  workflowExecutions WorkflowExecution[]

  @@index([userId])
  @@map("workflows")
}

/// Defines a single, discrete unit of work within a Workflow blueprint.
model StepDefinition {
  id          String  @id @default(uuid())
  workflowId  String  @map("workflow_id")
  name        String
  description String?
  /// References a registered capability in the Task Registry
  taskId      String  @map("task_id")

  /// JSON mapping of previous outputs to this step's inputs
  payloadTemplate Json @map("payload_template")

  /// Defines max retries, backoff strategy
  retryPolicy Json @map("retry_policy")

  /// Array of step_definition_ids that must complete first
  dependsOn Json @default("[]") @map("depends_on")

  workflow       Workflow        @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  stepExecutions StepExecution[]

  @@index([workflowId])
  @@map("step_definitions")
}

/// Represents a single, point-in-time runtime instance of a Workflow.
model WorkflowExecution {
  id              String         @id @default(uuid())
  workflowId      String         @map("workflow_id")
  status          WorkflowStatus @default(PENDING)
  startedAt       DateTime?      @map("started_at")
  completedAt     DateTime?      @map("completed_at")
  errorDetails    Json?          @map("error_details")
  plannerVersion  String?        @map("planner_version")
  executionTimeMs Int?           @map("execution_time_ms")

  /// We use RESTRICT here because deleting a Workflow blueprint 
  /// should fail if it has historical executions.
  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Restrict)

  stepExecutions StepExecution[]
  events         Event[]

  @@index([workflowId, status])
  @@map("workflow_executions")
}

/// The runtime instance of a Step Definition. This is the exact payload sent to a Worker.
model StepExecution {
  id               String @id @default(uuid())
  executionId      String @map("execution_id")
  stepDefinitionId String @map("step_definition_id")

  /// Transient Worker ID (Not a foreign key, managed by Redis)
  workerId String?    @map("worker_id")
  status   StepStatus @default(PENDING)

  /// Fully resolved input data
  inputPayload Json? @map("input_payload")

  /// Result from the worker
  outputPayload Json? @map("output_payload")

  attemptCount Int       @default(0) @map("attempt_count")
  startedAt    DateTime? @map("started_at")
  completedAt  DateTime? @map("completed_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  workflowExecution WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  stepDefinition    StepDefinition    @relation(fields: [stepDefinitionId], references: [id], onDelete: Cascade)

  // Events optionally linked to a specific step execution
  events Event[]

  @@index([executionId])
  @@index([status])
  @@map("step_executions")
}

/// An immutable ledger of everything that happens within the system.
model Event {
  id              String  @id @default(uuid())
  executionId     String  @map("execution_id")
  stepExecutionId String? @map("step_execution_id")

  /// Strongly typed event from EventType enum
  eventType EventType @map("event_type")
  payload   Json
  createdAt DateTime  @default(now()) @map("created_at")

  workflowExecution WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  stepExecution     StepExecution?    @relation(fields: [stepExecutionId], references: [id], onDelete: Cascade)

  @@index([executionId, createdAt])
  @@map("events")
}
