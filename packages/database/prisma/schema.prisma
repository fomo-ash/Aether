generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// ENUMS
// ----------------------------------------------------------------------------

enum CommitmentStatus {
  PENDING
  AWAITING_VERIFICATION
  VERIFIED_FULFILLED
  VERIFIED_MISSED
  UNRESOLVED
  CANCELLED
}

enum RewardPoolTransactionType {
  INITIAL_FUNDING
  BET_REWARD
  BET_BOOTSTRAP_REWARD
  BET_FORFEIT
  MANUAL_ADJUSTMENT
}

enum ResolutionStatus {
  FULFILLED
  MISSED
  UNRESOLVED
}

enum TransactionType {
  COMMITMENT_FULFILLED
  COMMITMENT_MISSED
  BET_WON
  BET_LOST
  BET_STAKE_LOCK
  BET_STAKE_RELEASE
  BET_STAKE_FORFEIT
  BET_REWARD
  BET_BOOTSTRAP_REWARD
  BET_REFUND
  MANUAL_ADJUSTMENT
}

enum BetStatus {
  BET_PROPOSED
  BET_FORMALIZED
  BET_ACTIVE
  AWAITING_RESOLUTION
  EVIDENCE_COLLECTION
  RESOLVED
  REPUTATION_SETTLED
  UNRESOLVED

  ACTIVE
  AWAITING_VERIFICATION
  FULFILLED
  MISSED
  CANCELLED
  EXPIRED
}

// ----------------------------------------------------------------------------
// MODELS
// ----------------------------------------------------------------------------

/// Represents a human or system actor interacting with Aether.
model User {
  id                String   @id @default(uuid())
  email             String?  @unique
  apiKeyHash        String?  @unique @map("api_key_hash")
  bootstrapBetsUsed Int      @default(0) @map("bootstrap_bets_used")
  createdAt         DateTime @default(now()) @map("created_at")

  commitments         Commitment[]
  reputationAccounts  ReputationAccount[]
  bets                Bet[]
  communityMembers    CommunityMember[]
  identities          UserIdentity[]
  githubInstallations UserGithubInstallation[]

  @@map("users")
}

model UserIdentity {
  id         String @id @default(uuid())
  userId     String @map("user_id")
  platform   String
  externalId String @map("external_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([platform, externalId])
  @@map("user_identities")
}

/// Represents a Discord server, Telegram group, Slack workspace, etc.
model Community {
  id                   String   @id @default(uuid())
  name                 String
  platform             String // e.g., "discord", "telegram"
  externalId           String   @map("external_id") // e.g., Discord server ID
  defaultRepository    String?  @map("default_repository") // e.g. "owner/aether"
  githubInstallationId String?  @map("github_installation_id") // Auth for GitHub App
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  members             CommunityMember[]
  reputationAccounts  ReputationAccount[]
  commitments         Commitment[]
  bets                Bet[]
  githubInstallations CommunityGithubInstallation[]

  @@unique([platform, externalId])
  @@map("communities")
}

/// Represents a User's membership in a Community.
model CommunityMember {
  id          String   @id @default(uuid())
  communityId String   @map("community_id")
  userId      String   @map("user_id")
  joinedAt    DateTime @default(now()) @map("joined_at")
  displayName String?  @map("display_name")
  status      String? // Active, inactive, banned

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@map("community_members")
}

/// The account tracking a user's reputation points within a specific Community.
model ReputationAccount {
  id            String   @id @default(uuid())
  communityId   String   @map("community_id")
  userId        String   @map("user_id")
  balance       Int      @default(0) // Available
  lockedBalance Int      @default(0) @map("locked_balance") // Locked in active bets
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  community    Community               @relation(fields: [communityId], references: [id], onDelete: Restrict)
  user         User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  transactions ReputationTransaction[]

  @@unique([userId, communityId])
  @@index([communityId, balance])
  @@map("reputation_accounts")
}

model RewardPool {
  id       String  @id @default(uuid())
  isGlobal Boolean @unique @default(true) // Enforces singleton
  balance  Int     @default(0)

  transactions RewardPoolTransaction[]

  @@map("reward_pool")
}

model RewardPoolTransaction {
  id           String                    @id @default(uuid())
  rewardPoolId String                    @map("reward_pool_id")
  type         RewardPoolTransactionType
  amount       Int // Positive or negative
  betId        String?                   @map("bet_id")
  referenceKey String                    @unique @map("reference_key")
  createdAt    DateTime                  @default(now()) @map("created_at")
  metadata     Json?

  rewardPool RewardPool @relation(fields: [rewardPoolId], references: [id], onDelete: Restrict)

  @@map("reward_pool_transactions")
}

/// An immutable ledger of reputation changes.
model ReputationTransaction {
  id                  String          @id @default(uuid())
  reputationAccountId String          @map("reputation_account_id")
  amount              Int // Positive or negative
  transactionType     TransactionType @map("transaction_type")
  reason              String
  commitmentId        String?         @map("commitment_id")
  betId               String?         @map("bet_id")
  referenceKey        String          @unique @map("reference_key") // Idempotency key
  createdAt           DateTime        @default(now()) @map("created_at")
  metadata            Json?

  reputationAccount ReputationAccount @relation(fields: [reputationAccountId], references: [id], onDelete: Restrict)
  commitment        Commitment?       @relation(fields: [commitmentId], references: [id], onDelete: SetNull)
  bet               Bet?              @relation(fields: [betId], references: [id], onDelete: SetNull)

  @@map("reputation_transactions")
}

/// Core product entity: what a user said they will do.
model Commitment {
  id                   String           @id @default(uuid())
  userId               String           @map("user_id")
  communityId          String?          @map("community_id")
  statement            String // The original natural language statement
  normalizedClaim      String           @map("normalized_claim") // Formalized claim
  status               CommitmentStatus @default(PENDING)
  createdAt            DateTime         @default(now()) @map("created_at")
  deadline             DateTime? // When it needs to be fulfilled by
  resolutionAt         DateTime?        @map("resolution_at") // When the engine will check it
  sourceChannel        String           @map("source_channel") // Discord, Slack, Telegram
  sourceConversationId String           @map("source_conversation_id")
  sourceMessageId      String           @map("source_message_id")

  /// e.g. { "reward": 5, "penalty": 5 }
  rewardPenaltyPolicy Json? @map("reward_penalty_policy")

  // Relations
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  community              Community?              @relation(fields: [communityId], references: [id], onDelete: SetNull)
  verificationPolicy     VerificationPolicy?
  resolution             Resolution?
  evidence               Evidence[]
  events                 Event[]
  reputationTransactions ReputationTransaction[]

  // For Bets: A commitment might be part of a bet
  bet Bet? @relation("BetCommitments")

  @@index([userId])
  @@index([communityId])
  @@index([status])
  @@map("commitments")
}

/// Structured policy on how to deterministically verify a commitment.
model VerificationPolicy {
  id               String  @id @default(uuid())
  commitmentId     String  @unique @map("commitment_id")
  verifierType     String  @map("verifier_type") // e.g., github.issue_status
  target           String // What is being verified (e.g., github repo or URL)
  successCondition Json    @map("success_condition") // JSON rule for passing
  schedule         String? // Cron or logic for when to check
  configuration    Json? // Additional provider config

  commitment Commitment @relation(fields: [commitmentId], references: [id], onDelete: Cascade)

  @@map("verification_policies")
}

/// Represents collected external data to prove or disprove a claim.
model Evidence {
  id                 String   @id @default(uuid())
  commitmentId       String?  @map("commitment_id")
  betId              String?  @map("bet_id")
  source             String // Source of truth (e.g., GitHub API)
  externalIdentifier String?  @map("external_identifier") // Issue ID, URL, etc.
  payload            Json // Captured data / payload
  observedState      String   @map("observed_state") // E.g., CLOSED, SUCCESS
  collectedAt        DateTime @default(now()) @map("collected_at")
  metadata           Json?

  commitment Commitment? @relation(fields: [commitmentId], references: [id], onDelete: Restrict)
  bet        Bet?        @relation(fields: [betId], references: [id], onDelete: Restrict)

  @@index([commitmentId])
  @@index([betId])
  @@map("evidence")
}

/// The final verdict on a commitment based on evidence and verification policy.
model Resolution {
  id           String           @id @default(uuid())
  commitmentId String?          @unique @map("commitment_id")
  betId        String?          @unique @map("bet_id")
  status       ResolutionStatus
  result       String // Summary of the result
  explanation  String // Detailed explanation or deterministic log
  resolvedAt   DateTime         @default(now()) @map("resolved_at")
  evidenceRefs Json             @map("evidence_refs") // List of evidence IDs used

  commitment Commitment? @relation(fields: [commitmentId], references: [id], onDelete: Restrict)
  bet        Bet?        @relation(fields: [betId], references: [id], onDelete: Restrict)

  @@map("resolutions")
}

/// Represents a specialized commitment involving competing claims (The Bet).
model Bet {
  id              String    @id @default(uuid())
  creatorId       String    @map("creator_id")
  communityId     String    @map("community_id")
  status          BetStatus @default(ACTIVE)
  stake           Int
  multiplier      Int? // Nullable for bootstrap bets
  potentialPayout Int       @map("potential_payout")
  isBootstrap     Boolean   @default(false) @map("is_bootstrap")

  commitmentId String   @unique @map("commitment_id")
  deadline     DateTime // Mirrored/synced from Commitment for query speed

  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  resolvedAt          DateTime? @map("resolved_at")
  settlementReference String?   @unique @map("settlement_reference")

  creator                User                    @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  community              Community               @relation(fields: [communityId], references: [id], onDelete: Restrict)
  commitment             Commitment              @relation("BetCommitments", fields: [commitmentId], references: [id], onDelete: Restrict)
  reputationTransactions ReputationTransaction[]
  evidence               Evidence[]
  resolution             Resolution?
  events                 Event[]

  @@index([communityId])
  @@map("bets")
}

/// An immutable ledger of state transitions for auditing.
model Event {
  id           String   @id @default(uuid())
  commitmentId String?  @map("commitment_id")
  betId        String?  @map("bet_id")
  eventType    String   @map("event_type")
  payload      Json
  createdAt    DateTime @default(now()) @map("created_at")

  commitment Commitment? @relation(fields: [commitmentId], references: [id], onDelete: SetNull)
  bet        Bet?        @relation(fields: [betId], references: [id], onDelete: SetNull)

  @@index([commitmentId, createdAt])
  @@index([betId, createdAt])
  @@map("events")
}

// ----------------------------------------------------------------------------
// GITHUB INSTALLATION & OAUTH MODELS
// ----------------------------------------------------------------------------

model OauthState {
  id                        String    @id @default(uuid())
  tokenHash                 String    @unique @map("token_hash")
  userId                    String    @map("user_id")
  communityId               String?   @map("community_id")
  pendingCommitmentStateKey String?   @map("pending_commitment_state_key") // To resume conversation
  expiresAt                 DateTime  @map("expires_at")
  consumedAt                DateTime? @map("consumed_at")
  createdAt                 DateTime  @default(now()) @map("created_at")

  @@map("oauth_states")
}

model GithubInstallation {
  id              String   @id @default(uuid())
  installationId  String   @unique @map("installation_id")
  githubAccountId BigInt   @map("github_account_id") // Stable numeric ID
  accountLogin    String   @map("account_login")
  accountType     String   @map("account_type")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  userLinks      UserGithubInstallation[]
  communityLinks CommunityGithubInstallation[]

  @@map("github_installations")
}

model UserGithubInstallation {
  userId               String @map("user_id")
  githubInstallationId String @map("github_installation_id")

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  installation GithubInstallation @relation(fields: [githubInstallationId], references: [id], onDelete: Cascade)

  @@id([userId, githubInstallationId])
  @@map("user_github_installations")
}

model CommunityGithubInstallation {
  communityId          String @map("community_id")
  githubInstallationId String @map("github_installation_id")

  community    Community          @relation(fields: [communityId], references: [id], onDelete: Cascade)
  installation GithubInstallation @relation(fields: [githubInstallationId], references: [id], onDelete: Cascade)

  @@id([communityId, githubInstallationId])
  @@map("community_github_installations")
}
